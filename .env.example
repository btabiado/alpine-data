# Environment variables for local runs. Every one is optional: an unset key
# turns its feature off with a stated reason, or falls back to a keyless path.
#
# Copy to `.env` and fill in what you need. NEVER commit `.env` (gitignored).
# lthcs_daily.py loads `.env` on its own (its source clients call python-dotenv).
# For everything else, export it into your shell first:
#   set -a; . ./.env; set +a
# In CI the same names come from GitHub Actions secrets.

# ── LTHCS pipeline (lthcs_daily.py) ───────────────────────────────────────
# SEC EDGAR asks for a real contact in the User-Agent: "Name email@example.com".
SEC_USER_AGENT=
# FRED (https://fred.stlouisfed.org/docs/api/api_key.html): macro inputs to DES; also the dashboard's macro overlay, CPI and metals.
FRED_API_KEY=
# EIA (https://www.eia.gov/opendata/register.php): WTI / Brent / gasoline for DES.
EIA_API_KEY=
# Finnhub (https://finnhub.io/register): analyst recommendations, the primary Thesis input.
FINNHUB_API_KEY=
# Alpha Vantage (https://www.alphavantage.co/support/#api-key): news sentiment, 25 req/day free; skipped by --skip-thesis.
ALPHA_VANTAGE_API_KEY=
# Anthropic (https://console.anthropic.com/): LLM narrative / sentiment shadows, and the dashboard chat dock.
ANTHROPIC_API_KEY=
# LLM shadows: off unless set to 1 (both need ANTHROPIC_API_KEY; defaults: claude-haiku-4-5, caps $6.17 / $3.08 per day).
# LTHCS_LLM_NARRATIVES_ENABLED=0
# LTHCS_LLM_NARRATIVES_MODEL=claude-haiku-4-5
# LTHCS_LLM_NARRATIVES_MAX_USD_PER_DAY=6.17
# LTHCS_LLM_SENTIMENT_ENABLED=0
# LTHCS_LLM_SENTIMENT_MODEL=claude-haiku-4-5
# LTHCS_LLM_SENTIMENT_MAX_USD_PER_DAY=3.08
# Response cache for the source clients (default .cache/lthcs, gitignored).
# LTHCS_CACHE_DIR=.cache/lthcs
# Score the crypto extension inside lthcs_daily.py too (default off; lthcs-crypto-daily.yml scores crypto separately).
# LTHCS_CRYPTO_ENABLED=0

# ── Dashboard fetchers (fetch_market.py and friends) ──────────────────────
# CoinGecko Demo key: more headroom for the daily top-50 sweep; keyless works but falls back to exchange candles more often.
COINGECKO_API_KEY=
# Glassnode: true whale-cohort exchange-flow series (free proxies are shown without it).
GLASSNODE_API_KEY=
# Coin Metrics: ETH whale series on the Whale tab.
COINMETRICS_API_KEY=
# Etherscan v2: the 90-day ETH blocks-per-day chart (the gas oracle is keyless).
ETHERSCAN_API_KEY=
# Reddit OAuth app: subscriber counts on the Research tab (RSS-only without it).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# GitHub token: higher rate limit for the Research tab's repo stats (anonymous = 60 req/hour).
GITHUB_TOKEN=
# OpenSky OAuth2 client: higher limits for the Aviation tab's live traffic (fetch_opensky.py).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# ── City tab (fetch_city.py) ──────────────────────────────────────────────
# Socrata app token (one token works on all five city portals); without it large tables throttle.
SOCRATA_APP_TOKEN=
# Census ACS: median income / rent / home value and effective property tax.
CENSUS_API_KEY=
# EPA AirNow: current AQI per city.
AIRNOW_API_KEY=
# FBI Crime Data Explorer (key via https://api.data.gov/signup/): Miami's Public Safety pillar.
FBI_CDE_API_KEY=
# BLS LAUS: unemployment; works keyless, a key only raises the daily limit.
BLS_API_KEY=

# ── Local server (server.py) ──────────────────────────────────────────────
# HTTP Basic Auth. server.py refuses a non-loopback HOST without both (DASH_ALLOW_INSECURE=1 overrides).
DASH_USER=
DASH_PASS=
# HOST=127.0.0.1
# PORT=8765
# Background refresh interval in minutes; 0 disables it.
# REFRESH_MINUTES=30
# Base URL used in share links (share.py).
# SHARE_HOST=http://127.0.0.1:8765
# Chat dock model (default claude-haiku-4-5-20251001).
# CHAT_MODEL=
